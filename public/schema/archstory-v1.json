{
  "title": "archstory/v1 design",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "archstory/v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "meta": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "tags": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "difficulty": {
          "type": "string",
          "enum": [
            "easy",
            "medium",
            "hard"
          ]
        },
        "author": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "kind": {
          "description": "\"system\" (default): a system design. \"protocol\": a step-by-step network protocol timeline, where nodes are the actors and flows are scenarios",
          "type": "string",
          "enum": [
            "system",
            "protocol"
          ]
        },
        "order": {
          "description": "Sort position among designs of the same kind (lower first); designs without one sort by title after those with one",
          "type": "number"
        }
      },
      "required": [
        "title"
      ]
    },
    "requirements": {
      "default": {
        "functional": [],
        "nonFunctional": [],
        "scale": []
      },
      "type": "object",
      "properties": {
        "functional": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "nonFunctional": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "scale": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string"
              },
              "value": {
                "type": "string"
              }
            },
            "required": [
              "label",
              "value"
            ]
          }
        },
        "estimate": {
          "description": "Starting numbers for the estimate calculator, matching the scale above",
          "type": "object",
          "properties": {
            "source": {
              "description": "Work out daily writes from users (dau x writesPerUser) or from a stated volume",
              "type": "string",
              "enum": [
                "users",
                "volume"
              ]
            },
            "dau": {
              "type": "number",
              "minimum": 0
            },
            "writesPerUser": {
              "type": "number",
              "minimum": 0
            },
            "volume": {
              "type": "number",
              "minimum": 0
            },
            "volumeUnit": {
              "type": "string",
              "enum": [
                "second",
                "day",
                "month"
              ]
            },
            "readsPerWrite": {
              "description": "Reads for every write; use 0 for write-only systems",
              "type": "number",
              "minimum": 0
            },
            "peakFactor": {
              "description": "Peak traffic as a multiple of the average",
              "type": "number",
              "minimum": 0
            },
            "writeBytes": {
              "description": "Bytes stored per write",
              "type": "number",
              "minimum": 0
            },
            "readBytes": {
              "description": "Bytes sent per read",
              "type": "number",
              "minimum": 0
            },
            "years": {
              "type": "number",
              "minimum": 0
            },
            "replicas": {
              "description": "Copies of the data kept",
              "type": "number",
              "minimum": 0
            },
            "cachePercent": {
              "description": "Percent of a day's reads worth caching",
              "type": "number",
              "minimum": 0
            },
            "perInstance": {
              "description": "Requests per second one service instance handles",
              "type": "number",
              "minimum": 0
            },
            "objectPercent": {
              "description": "Percent of stored data in object storage rather than a database (cost estimate)",
              "type": "number",
              "minimum": 0
            },
            "cdnPercent": {
              "description": "Percent of egress already served by a CDN",
              "type": "number",
              "minimum": 0
            },
            "cdnPotential": {
              "description": "Percent of egress a CDN could serve",
              "type": "number",
              "minimum": 0
            },
            "spotPercent": {
              "description": "Percent of compute that is interruptible background work",
              "type": "number",
              "minimum": 0
            }
          }
        }
      }
    },
    "nodes": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "description": "Cloud-neutral display name, e.g. \"Load Balancer\""
          },
          "kind": {
            "type": "string",
            "minLength": 1,
            "description": "Component type, e.g. load_balancer (L7, HTTP), network_load_balancer (L4, TCP/UDP), service, cache, sql_db. Unknown kinds are allowed."
          },
          "tier": {
            "description": "Band on the canvas. Defaults from kind when omitted.",
            "type": "string",
            "enum": [
              "client",
              "edge",
              "entry",
              "services",
              "data",
              "async",
              "external"
            ]
          },
          "description": {
            "type": "string"
          },
          "group": {
            "description": "Id of a group (region, tenant, …) this node sits inside",
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "subnet": {
            "description": "Override the subnet chosen by tier; \"none\" places the node outside the VPC (managed service)",
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "site": {
            "description": "Where it runs: \"cloud\" (default) or \"onprem\" (your own data centre, reached from the cloud over a hybrid_link node). An on-prem node sits outside the VPC, the cloud zones and the regions: it takes no cloud subnet, regions or replication, and zones and ha are ignored",
            "type": "string",
            "enum": [
              "cloud",
              "onprem"
            ]
          },
          "zones": {
            "description": "Availability zones this node spans; defaults to network.zones",
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "ha": {
            "description": "How it survives a zone failure. Defaults by kind: services active-active, SQL/cache primary-standby, managed services regional",
            "type": "string",
            "enum": [
              "active-active",
              "primary-standby",
              "quorum",
              "regional",
              "single"
            ]
          },
          "replicas": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "regions": {
            "description": "Where it runs when the design has a regions section: \"all\" (a copy in every region, run as the DR strategy says), \"primary\" (only in the primary region, so it is lost with it), \"global\" (one global service outside any region: DNS, CDN, global load balancer, or a globally replicated store). Defaults: edge tier (DNS, CDN, WAF) global, everything else all; clients and external services always sit outside the regions",
            "type": "string",
            "enum": [
              "all",
              "primary",
              "global"
            ]
          },
          "replication": {
            "description": "Data stores only: how its data reaches other regions. \"sync\" (a write commits in two regions: nothing lost, every write pays a cross-region round trip), \"async\" (replicated after commit: a region loss loses the replication lag), \"backup\" (snapshots copied across: loses everything since the last one), \"none\". Defaults to \"backup\" for the backup-restore strategy, \"none\" for caches, otherwise \"async\"",
            "type": "string",
            "enum": [
              "sync",
              "async",
              "backup",
              "none"
            ]
          },
          "icon": {
            "description": "Emoji override",
            "type": "string"
          },
          "cloud": {
            "description": "Provider-specific product names, e.g. { \"aws\": \"ALB\", \"gcp\": \"Cloud Load Balancing\" }",
            "type": "object",
            "properties": {
              "aws": {
                "type": "string"
              },
              "gcp": {
                "type": "string"
              },
              "azure": {
                "type": "string"
              }
            }
          }
        },
        "required": [
          "id",
          "label",
          "kind"
        ]
      }
    },
    "groups": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "label": {
            "type": "string"
          },
          "kind": {
            "default": "boundary",
            "type": "string",
            "enum": [
              "region",
              "zone",
              "network",
              "tenant",
              "cluster",
              "boundary"
            ]
          }
        },
        "required": [
          "id",
          "label"
        ]
      }
    },
    "edges": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "to": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "label": {
            "type": "string"
          },
          "protocol": {
            "type": "string"
          },
          "async": {
            "description": "Fire-and-forget / queued connection",
            "type": "boolean"
          }
        },
        "required": [
          "from",
          "to"
        ]
      }
    },
    "flows": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "title": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "steps": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "from": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9_-]*$"
                },
                "to": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9_-]*$"
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "req",
                    "res",
                    "async",
                    "local"
                  ],
                  "description": "req/res/async travel an edge (either direction); local happens inside one node (from === to)"
                },
                "phase": {
                  "description": "Stage of the flow this step belongs to, e.g. \"Request in\" or \"Persist & replicate\". Consecutive steps with the same phase are grouped in the step list; a step with no phase continues the previous one",
                  "type": "string"
                },
                "label": {
                  "type": "string",
                  "description": "Short wire label, e.g. \"GET /aZ3k9Q\" or \"SET key ttl=24h\""
                },
                "detail": {
                  "description": "Why this hop happens; the teaching text",
                  "type": "string"
                },
                "payload": {
                  "description": "Example message: HTTP, SQL, JSON event…",
                  "type": "string"
                },
                "state": {
                  "description": "Protocol designs: the named state of each listed actor (node id) AFTER this step, e.g. { \"client\": \"ESTABLISHED\" }. Actors not listed keep their state",
                  "type": "object",
                  "propertyNames": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9_-]*$"
                  },
                  "additionalProperties": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "fields": {
                  "description": "Protocol designs: the anatomy of the message on the wire (flags, sequence numbers, header bits, sections)",
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string",
                        "minLength": 1,
                        "description": "Header field or section, e.g. \"flags\" or \"seq\""
                      },
                      "value": {
                        "type": "string",
                        "description": "Its value in this message, e.g. \"SYN, ACK\" or \"5000\""
                      },
                      "note": {
                        "description": "Why it has this value",
                        "type": "string"
                      }
                    },
                    "required": [
                      "name",
                      "value"
                    ]
                  }
                },
                "delay": {
                  "description": "One-way network delay of this step, in one-way trips (half a round trip). Defaults to 1 for a step between two nodes and 0 for a local step; use 0 for a message sent right behind the previous one",
                  "type": "number",
                  "minimum": 0
                }
              },
              "required": [
                "from",
                "to",
                "kind",
                "label"
              ]
            }
          }
        },
        "required": [
          "id",
          "title",
          "steps"
        ]
      }
    },
    "notes": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "target": {
            "description": "Node, group or flow id; omit for a design-wide note",
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "kind": {
            "default": "note",
            "type": "string",
            "enum": [
              "tradeoff",
              "scaling",
              "failure",
              "security",
              "note"
            ]
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "text"
        ]
      }
    },
    "network": {
      "type": "object",
      "properties": {
        "cidr": {
          "description": "VPC address range, e.g. 10.0.0.0/16",
          "type": "string"
        },
        "zones": {
          "default": 1,
          "description": "Availability zones the VPC spans",
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        },
        "subnets": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9_-]*$"
              },
              "label": {
                "type": "string"
              },
              "public": {
                "default": false,
                "description": "Has a route to the internet gateway",
                "type": "boolean"
              },
              "tiers": {
                "default": [],
                "description": "Nodes in these tiers land in this subnet unless they override it",
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "client",
                    "edge",
                    "entry",
                    "services",
                    "data",
                    "async",
                    "external"
                  ]
                }
              },
              "cidr": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "label"
            ]
          }
        },
        "egress": {
          "default": "nat",
          "description": "How private subnets reach the internet",
          "type": "string",
          "enum": [
            "nat",
            "none"
          ]
        }
      },
      "required": [
        "subnets"
      ],
      "description": "Optional network layer: VPC, subnets and availability zones"
    },
    "regions": {
      "type": "object",
      "properties": {
        "regions": {
          "minItems": 2,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9_-]*$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "description": "Display name, e.g. \"us-east-1\" or \"Europe (Frankfurt)\""
              },
              "role": {
                "type": "string",
                "enum": [
                  "primary",
                  "secondary",
                  "active"
                ],
                "description": "primary serves traffic and secondary waits as the DR site (backup-restore, pilot-light, warm-standby); every region is active in active-active"
              }
            },
            "required": [
              "id",
              "name",
              "role"
            ]
          }
        },
        "strategy": {
          "type": "string",
          "enum": [
            "backup-restore",
            "pilot-light",
            "warm-standby",
            "active-active"
          ],
          "description": "Disaster recovery strategy, cheapest and slowest first: backup-restore (restore data and redeploy: hours), pilot-light (data replicated, compute off: tens of minutes), warm-standby (a scaled-down copy running: minutes), active-active (every region serves: near zero)"
        },
        "rto": {
          "type": "string",
          "description": "Recovery time objective: how long the system may be down after losing a region, e.g. \"15 min\""
        },
        "rpo": {
          "type": "string",
          "description": "Recovery point objective: how much recent data may be lost, e.g. \"1 min\" or \"0\""
        },
        "failover": {
          "type": "string",
          "description": "How traffic moves to the surviving region, e.g. \"DNS failover on health checks\" or \"global load balancer with anycast IPs\""
        },
        "dnsTtl": {
          "description": "TTL in seconds of the DNS records failover changes; resolvers keep sending users to the failed region until it expires",
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "regions",
        "strategy",
        "rto",
        "rpo",
        "failover"
      ],
      "description": "Optional multi-region layer: regions, disaster recovery strategy, RTO and RPO, and how traffic fails over"
    },
    "observability": {
      "type": "object",
      "properties": {
        "slos": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9_-]*$"
              },
              "name": {
                "type": "string"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "availability",
                  "latency",
                  "freshness",
                  "durability",
                  "correctness"
                ]
              },
              "sli": {
                "type": "string",
                "description": "How it is measured: good events divided by all events, and where it is measured"
              },
              "target": {
                "type": "number",
                "minimum": 50,
                "maximum": 100,
                "description": "Percent of events that must be good, e.g. 99.9"
              },
              "threshold": {
                "description": "What counts as a good event for latency or freshness SLOs, e.g. \"< 100 ms\"",
                "type": "string"
              },
              "window": {
                "default": 30,
                "description": "Rolling window in days",
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "id",
              "name",
              "kind",
              "sli",
              "target"
            ]
          }
        },
        "alerts": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9_-]*$"
              },
              "severity": {
                "type": "string",
                "enum": [
                  "page",
                  "ticket"
                ],
                "description": "page: wake someone now (users are hurting); ticket: fix in working hours"
              },
              "when": {
                "type": "string",
                "description": "The condition, with a threshold and duration"
              },
              "why": {
                "type": "string",
                "description": "What it protects and why this severity"
              },
              "target": {
                "description": "Component it watches",
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9_-]*$"
              },
              "slo": {
                "description": "SLO it protects",
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9_-]*$"
              }
            },
            "required": [
              "id",
              "severity",
              "when",
              "why"
            ]
          }
        },
        "signals": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "target": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9_-]*$"
              },
              "name": {
                "type": "string"
              },
              "metric": {
                "type": "string"
              },
              "why": {
                "type": "string"
              }
            },
            "required": [
              "target",
              "name"
            ],
            "description": "A signal specific to this design, shown with the component's standard signals"
          }
        },
        "debug": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "symptom": {
                "type": "string"
              },
              "steps": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "symptom",
              "steps"
            ]
          }
        }
      },
      "description": "Optional monitoring layer: service level objectives, alerts, signals and debugging paths. Standard signals per component type are built in."
    },
    "questions": {
      "default": [],
      "description": "Follow-up questions with model answers, for drilling",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "q": {
            "type": "string",
            "description": "A follow-up question an interviewer would ask about this design"
          },
          "a": {
            "type": "string",
            "description": "A short model answer: the points a strong candidate makes, in 2 to 4 sentences"
          },
          "topic": {
            "type": "string",
            "enum": [
              "requirements",
              "scale",
              "data",
              "consistency",
              "reliability",
              "performance",
              "security",
              "operations",
              "tradeoffs"
            ]
          },
          "targets": {
            "default": [],
            "description": "Ids of the components the question is about",
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_-]*$"
            }
          }
        },
        "required": [
          "id",
          "q",
          "a"
        ]
      }
    },
    "reasoning": {
      "description": "Practice mode written answers keyed by section, e.g. { \"estimates\": \"…\", \"api\": \"…\" }",
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "required": [
    "schema",
    "id",
    "meta",
    "nodes"
  ]
}
